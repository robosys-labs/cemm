      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "scenario_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "case_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
