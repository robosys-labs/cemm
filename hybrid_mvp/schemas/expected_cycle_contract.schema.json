                                "if": {
                                  "properties": {
                                    "value_type": {
                                      "const": "string"
                                    }
                                  }
                                },
                                "then": {
                                  "properties": {
                                    "value": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              {
                                "if": {
                                  "properties": {
                                    "value_type": {
                                      "const": "integer"
                                    }
                                  }
                                },
                                "then": {
                                  "properties": {
                                    "value": {
                                      "type": "integer"
                                    }
                                  }
                                }
                              },
                              {
                                "if": {
                                  "properties": {
                                    "value_type": {
                                      "const": "boolean"
                                    }
                                  }
                                },
                                "then": {
                                  "properties": {
                                    "value": {
                                      "type": "boolean"
                                    }
                                  }
                                }
                              }
                            ]
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "variable_ref"
                            ],
                            "properties": {
                              "kind": {
                                "const": "bound_variable"
                              },
                              "variable_ref": {
                                "type": "string",
                                "pattern": "^\\?.+"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "node_ref"
                            ],
                            "properties": {
                              "kind": {
                                "const": "expression_node"
                              },
                              "node_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "unresolved_ref"
                            ],
                            "properties": {
                              "kind": {
                                "const": "unresolved"
                              },
                              "unresolved_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                "qualifiers": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role_ref",
                      "filler"
                    ],
                    "properties": {
                      "role_ref": {
                        "type": "string",
                        "pattern": "^role:.+"
                      },
                      "filler": {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "target_ref"
                            ],
                            "properties": {
                              "kind": {
                                "const": "grounded"
                              },
                              "target_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "value_type",
                              "value"
                            ],
                            "properties": {
                              "kind": {
                                "const": "literal"
                              },
                              "value_type": {
                                "enum": [
                                  "string",
                                  "integer",
                                  "boolean"
                                ]
                              },
                              "value": {
                                "oneOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 4096
                                  },
                                  {
                                    "type": "integer"
                                  },
                                  {
                                    "type": "boolean"
                                  }
                                ]
                              }
                            },
                            "allOf": [
                              {
                                "if": {
                                  "properties": {
                                    "value_type": {
                                      "const": "string"
                                    }
                                  }
                                },
                                "then": {
                                  "properties": {
                                    "value": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              {
                                "if": {
                                  "properties": {
                                    "value_type": {
                                      "const": "integer"
                                    }
                                  }
                                },
                                "then": {
                                  "properties": {
                                    "value": {
                                      "type": "integer"
                                    }
                                  }
                                }
                              },
                              {
                                "if": {
                                  "properties": {
                                    "value_type": {
                                      "const": "boolean"
                                    }
                                  }
