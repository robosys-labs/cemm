                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "node_ref"
                            ],
                            "properties": {
                              "kind": {
                                "const": "expression_node"
                              },
                              "node_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
                              }
                            }
