{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cemm.invalid/schemas/expected_cycle_contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abi_version",
    "contract_ref",
    "scenario_ref",
    "case_ref",
    "surface_ref",
    "context_ref",
    "assertion_refs",
    "outcome_kind",
    "expected_expressions",
    "expression_relation",
    "normalized_assertions",
    "expected_mode",
    "situation_constraints",
    "expected_decision",
    "expected_effect",
    "expected_response",
