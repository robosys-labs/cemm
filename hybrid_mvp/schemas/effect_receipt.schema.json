{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cemm.invalid/schemas/effect_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abi_version",
    "receipt_ref",
    "status",
    "idempotency_key",
    "journal_origin_ref",
    "journal_preterminal_ref",
    "reconciliation_required",
    "decision_ref",
    "verified_meaning_ref",
    "expression_ref",
    "situation_ref",
    "program_ref",
    "effect_intent_ref",
    "actor_ref",
    "event_type_ref",
    "transition_ref",
    "adapter_ref",
    "adapter_result_ref",
    "operation_receipt_ref",
    "observed_delta_refs",
    "committed_fact_refs",
    "proof_refs",
    "blocker_refs",
    "input_revision_pin",
    "output_revision_pin"
  ],
  "properties": {
    "abi_version": {
      "const": 1
    },
    "receipt_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "status": {
      "enum": [
        "committed",
        "denied",
        "resource_unavailable",
        "adapter_missing",
        "pending",
        "failed",
        "stale_revision"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "journal_origin_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "journal_preterminal_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "reconciliation_required": {
      "type": "boolean"
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "verified_meaning_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "expression_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "situation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "program_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "effect_intent_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "event_type_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "transition_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter_result_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_receipt_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_delta_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "committed_fact_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "proof_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "blocker_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "input_revision_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_generation",
        "world_revision",
        "session_revision",
        "episode_revision",
        "effect_revision",
        "model_identity"
      ],
      "properties": {
        "authority_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
        },
        "world_revision": {
          "type": "integer",
          "minimum": 0
        },
        "session_revision": {
          "type": "integer",
          "minimum": 0
        },
        "episode_revision": {
          "type": "integer",
          "minimum": 0
        },
        "effect_revision": {
          "type": "integer",
          "minimum": 0
        },
        "model_identity": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "output_revision_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_generation",
        "world_revision",
        "session_revision",
        "episode_revision",
        "effect_revision",
        "model_identity"
      ],
      "properties": {
        "authority_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
        },
        "world_revision": {
          "type": "integer",
          "minimum": 0
        },
        "session_revision": {
          "type": "integer",
          "minimum": 0
        },
        "episode_revision": {
          "type": "integer",
          "minimum": 0
        },
        "effect_revision": {
          "type": "integer",
          "minimum": 0
        },
        "model_identity": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "committed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reconciliation_required": {
            "const": false
          },
          "observed_delta_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
            }
          },
          "committed_fact_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reconciliation_required": {
            "const": true
          }
        }
      }
    }
  ]
}
