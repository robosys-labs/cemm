{
  "$id": "https://robosys-labs.github.io/cemm/schemas/r4_proposal_supervision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {"properties": {"target_kind": {"const": "derive"}, "expected_expression_refs": {"minItems": 1}, "derivations": {"minItems": 1}, "abstention": {"type": "null"}}},
    {"properties": {"target_kind": {"const": "abstain"}, "expected_expression_refs": {"maxItems": 0}, "derivations": {"maxItems": 0}, "abstention": {"$ref": "#/$defs/abstention"}}}
  ],
  "properties": {
    "abi_version": {"const": 1},
    "proposal_target_ref": {"pattern": "^proposal_supervision_v1:[0-9a-f]{24}$", "type": "string"},
    "source_case_ref": {"$ref": "#/$defs/caseRef"},
    "target_kind": {"enum": ["derive", "abstain"]},
    "expected_expression_refs": {"items": {"pattern": "^expression:[0-9a-f]{24}$", "type": "string"}, "maxItems": 64, "type": "array", "uniqueItems": true},
    "expression_relation": {"const": "exact"},
    "derivations": {"items": {"$ref": "#/$defs/blueprint"}, "maxItems": 16, "type": "array", "uniqueItems": true},
    "abstention": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/abstention"}]},
    "review_refs": {"$ref": "#/$defs/nonemptyRefs"}
  },
  "required": ["abi_version", "proposal_target_ref", "source_case_ref", "target_kind", "expected_expression_refs", "expression_relation", "derivations", "abstention", "review_refs"],
  "title": "CEMM Proposal Supervision ABI 1",
  "type": "object",
  "$defs": {
    "abstention": {
      "additionalProperties": false,
      "properties": {
        "abi_version": {"const": 1},
        "abstention_ref": {"pattern": "^typed_abstention_v1:[0-9a-f]{24}$", "type": "string"},
        "gap_kind_ref": {"pattern": "^gap_kind:[^\\s:][^\\s]*$", "type": "string"},
        "critical": {"type": "boolean"},
        "earliest_owner": {"enum": ["orient", "propose", "verify", "evaluate", "effect", "realize"]},
        "safe_disposition": {"enum": ["frontier", "clarify", "reject"]}
      },
      "required": ["abi_version", "abstention_ref", "gap_kind_ref", "critical", "earliest_owner", "safe_disposition"],
      "type": "object"
    },
    "action": {
      "additionalProperties": false,
      "properties": {
        "abi_version": {"const": 1},
        "action_ref": {"pattern": "^derivation_action_v1:[0-9a-f]{24}$", "type": "string"},
        "action_index": {"maximum": 207, "minimum": 0, "type": "integer"},
        "action_type": {"enum": ["select_context", "select_mode", "select_designation", "instantiate_operator", "bind_role", "bind_reference", "bind_nested_application", "attach_scope", "project_variable", "propose_transition", "complete_program", "abstain"]},
        "selectors": {"items": {"$ref": "#/$defs/selector"}, "maxItems": 27, "type": "array", "uniqueItems": true}
      },
      "required": ["abi_version", "action_ref", "action_index", "action_type", "selectors"],
      "type": "object"
    },
    "blueprint": {
      "additionalProperties": false,
      "properties": {
        "abi_version": {"const": 1},
        "blueprint_ref": {"pattern": "^derivation_blueprint_v1:[0-9a-f]{24}$", "type": "string"},
        "program_abi_version": {"const": 2},
        "actions": {"items": {"$ref": "#/$defs/action"}, "maxItems": 208, "minItems": 3, "type": "array", "uniqueItems": true},
        "root_local_refs": {"items": {"$ref": "#/$defs/ref"}, "maxItems": 8, "minItems": 1, "type": "array", "uniqueItems": true}
      },
      "required": ["abi_version", "blueprint_ref", "program_abi_version", "actions", "root_local_refs"],
      "type": "object"
    },
    "caseRef": {"pattern": "^expanded_case_v2:[0-9a-f]{24}$", "type": "string"},
    "nonemptyRefs": {"items": {"$ref": "#/$defs/ref"}, "maxItems": 128, "minItems": 1, "type": "array", "uniqueItems": true},
    "ref": {"maxLength": 512, "minLength": 3, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:[^\\s:][^\\s]*$", "type": "string"},
    "selector": {
      "additionalProperties": false,
      "properties": {
        "abi_version": {"const": 1},
        "selector_ref": {"pattern": "^derivation_selector_v1:[0-9a-f]{24}$", "type": "string"},
        "selector_kind": {"enum": ["context_slot", "mode_slot", "designation_slot", "local_node", "frame_slot", "role_ref", "contribution_slot", "reference_slot", "scope_slot", "expression_link_slot", "variable_slot", "transition_slot", "source_geometry", "semantic_kind"]},
        "value_ref": {"$ref": "#/$defs/ref"}
      },
      "required": ["abi_version", "selector_ref", "selector_kind", "value_ref"],
      "type": "object"
    }
  }
}
