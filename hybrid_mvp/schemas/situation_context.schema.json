{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cemm.invalid/schemas/situation_context.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abi_version",
    "situation_ref",
    "orientation_ref",
    "proposal_context_ref",
    "evidence_packet_ref",
    "form_lattice_ref",
    "grounding_ref",
    "mode",
    "session_ref",
    "turn_ref",
    "turn_index",
    "session_phase_ref",
    "participant_refs",
    "speaker_ref",
    "addressee_ref",
    "actor_ref",
    "temporal_frame_ref",
    "interval",
    "source_kind",
    "source_scope",
    "source_confidence_q",
    "adapter_receipt_refs",
    "trusted_observation",
    "source_refs",
    "epistemic_frame_ref",
    "focus_snapshot_ref",
    "obligation_snapshot_ref",
    "resource_snapshot_ref",
    "permission_snapshot_ref",
    "adapter_snapshot_ref",
    "focus_refs",
    "obligation_refs",
    "resource_refs",
    "permission_refs",
    "adapter_refs",
    "provenance_refs",
    "revision_pin"
  ],
  "properties": {
    "abi_version": {
      "const": 1
    },
    "situation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "orientation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "proposal_context_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "evidence_packet_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "form_lattice_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "grounding_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "mode": {
      "enum": [
        "OBSERVE",
        "QUERY",
        "REQUEST",
        "SIMULATE"
      ]
    },
    "session_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "turn_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "turn_index": {
      "type": "integer",
      "minimum": 1
    },
    "session_phase_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "participant_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "speaker_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "addressee_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "actor_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "temporal_frame_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "interval": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "source_kind": {
      "enum": [
        "text",
        "sensor",
        "operation",
        "mixed"
      ]
    },
    "source_scope": {
      "enum": [
        "conversation",
        "reviewed_observation",
        "operation_result",
        "mixed"
      ]
    },
    "source_confidence_q": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "adapter_receipt_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "trusted_observation": {
      "type": "boolean"
    },
    "source_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "epistemic_frame_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "focus_snapshot_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "obligation_snapshot_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "resource_snapshot_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "permission_snapshot_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "adapter_snapshot_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "focus_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "obligation_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "resource_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "permission_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "adapter_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "provenance_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "revision_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_generation",
        "world_revision",
        "session_revision",
        "episode_revision",
        "effect_revision",
        "model_identity"
      ],
      "properties": {
        "authority_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
        },
        "world_revision": {
          "type": "integer",
          "minimum": 0
        },
        "session_revision": {
          "type": "integer",
          "minimum": 0
        },
        "episode_revision": {
          "type": "integer",
          "minimum": 0
        },
        "effect_revision": {
          "type": "integer",
          "minimum": 0
        },
        "model_identity": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
