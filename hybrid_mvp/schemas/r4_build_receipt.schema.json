{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cemm.invalid/schemas/r4_build_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abi_version",
    "receipt_ref",
    "source_revision",
    "authority_generation",
    "abi_registry_ref",
    "scenario_source_sha256",
    "assertion_registry_sha256",
    "contract_set_sha256",
    "derivation_contract_set_sha256",
    "expanded_case_set_sha256",
    "episode_set_sha256",
    "mutation_set_sha256",
    "mutation_observation_set_sha256",
    "structural_sufficiency_sha256",
    "partition_evidence_sha256",
    "split_manifest_sha256",
    "partition_sufficiency_sha256",
    "split_payload_sha256s",
    "train_capability_sha256",
    "train_authorization_sha256",
    "admission_state"
  ],
  "properties": {
    "abi_version": {"const": 4},
    "receipt_ref": {"type": "string", "pattern": "^r4_build_v4:[0-9a-f]{24}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority_generation": {"type": "string", "minLength": 1},
    "abi_registry_ref": {"type": "string", "minLength": 1},
    "scenario_source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "assertion_registry_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contract_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "derivation_contract_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expanded_case_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "episode_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mutation_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mutation_observation_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "structural_sufficiency_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "partition_evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "split_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "partition_sufficiency_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "split_payload_sha256s": {
      "type": "array",
      "prefixItems": [
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "train_capability_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "train_authorization_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "admission_state": {"const": "candidate"}
  }
}
