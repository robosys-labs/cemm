{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cemm.example/schemas/training_source.schema.json",
  "title": "TrainingSource",
  "description": "Typed provenance for a training source. Human/teacher language is untrusted evidence.",
  "type": "object",
  "required": [
    "source_kind",
    "source_ref",
    "reviewed_target_ref",
    "independently_reverified"
  ],
  "properties": {
    "source_kind": {
      "type": "string",
      "enum": [
        "reviewed_scenario",
        "authority_derived",
        "human_paraphrase",
        "teacher_paraphrase",
        "verified_correction"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_target_ref": {
      "type": ["string", "null"],
      "description": "Required for untrusted evidence kinds (human_paraphrase, teacher_paraphrase, verified_correction)."
    },
    "independently_reverified": {
      "type": "boolean",
      "description": "Required true for untrusted evidence kinds."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source_kind": {
            "enum": ["human_paraphrase", "teacher_paraphrase", "verified_correction"]
          }
        },
        "required": ["source_kind"]
      },
      "then": {
        "properties": {
          "reviewed_target_ref": {
            "type": "string",
            "minLength": 1
          },
          "independently_reverified": {
            "const": true
          }
        },
        "required": ["reviewed_target_ref", "independently_reverified"]
      }
    }
  ]
}
