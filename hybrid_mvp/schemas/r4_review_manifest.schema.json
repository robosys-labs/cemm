{
  "$id": "https://robosys-labs.github.io/cemm/schemas/r4_review_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Schema owns structural, namespace, tag and fixed-path parity. The decoder owns content-address reconstruction and cross-record identity semantic postconditions.",
  "additionalProperties": false,
  "properties": {
    "abi_version": {"const": 1, "type": "integer"},
    "manifest_ref": {"maxLength": 512, "pattern": "^r4_review_manifest_v1:[0-9a-f]{24}$", "type": "string"},
    "review_policy_ref": {"maxLength": 512, "pattern": "^review_policy:[^\\s:][^\\s]*$", "type": "string"},
    "reviewer_refs": {"items": {"maxLength": 512, "pattern": "^reviewer:[^\\s:][^\\s]*$", "type": "string"}, "maxItems": 128, "minItems": 1, "type": "array", "uniqueItems": true},
    "reviewed_base_revision": {"pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$", "type": "string"},
    "authority_generation": {"maxLength": 512, "minLength": 1, "type": "string"},
    "source_bundle_ref": {"maxLength": 512, "pattern": "^r4_review_bundle_v1:[0-9a-f]{24}$", "type": "string"},
    "scenario_source_sha256": {"$ref": "#/$defs/sha256"},
    "sources": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"path": {"const": "data/review/r4_1/mutation_contracts.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"path": {"const": "data/review/r4_1/proposal_supervision.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"path": {"const": "data/review/r4_1/purpose_contract.json"}}}]},
        {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"path": {"const": "data/review/r4_1/realization_supervision.jsonl"}}}]}
      ],
      "type": "array"
    },
    "abi_versions": {"$ref": "#/$defs/abiVersions"},
    "approval_state": {"const": "approved"},
    "supersedes_refs": {"$ref": "#/$defs/refs"},
    "runtime_observations_are_source_authority": {"const": false, "type": "boolean"},
    "bootstrap_outputs_are_source_authority": {"const": false, "type": "boolean"}
  },
  "required": ["abi_version", "manifest_ref", "review_policy_ref", "reviewer_refs", "reviewed_base_revision", "authority_generation", "source_bundle_ref", "scenario_source_sha256", "sources", "abi_versions", "approval_state", "supersedes_refs", "runtime_observations_are_source_authority", "bootstrap_outputs_are_source_authority"],
  "title": "CEMM R4 Review Manifest ABI 1",
  "type": "object",
  "$defs": {
    "abiVersions": {
      "additionalProperties": false,
      "properties": {
        "mutation_contract": {"const": 1, "type": "integer"},
        "proposal_supervision": {"const": 1, "type": "integer"},
        "purpose_contract": {"const": 1, "type": "integer"},
        "r4_review_manifest": {"const": 1, "type": "integer"},
        "realization_supervision": {"const": 1, "type": "integer"}
      },
      "required": ["mutation_contract", "proposal_supervision", "purpose_contract", "r4_review_manifest", "realization_supervision"],
      "type": "object"
    },
    "reviewRefs": {"items": {"maxLength": 512, "pattern": "^source_review:[0-9a-f]{24}$", "type": "string"}, "maxItems": 128, "minItems": 1, "type": "array", "uniqueItems": true},
    "ref": {"maxLength": 512, "minLength": 3, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:[^\\s:][^\\s]*$", "type": "string"},
    "refs": {"items": {"$ref": "#/$defs/ref"}, "maxItems": 128, "type": "array", "uniqueItems": true},
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "source": {
      "additionalProperties": false,
      "properties": {
        "abi_version": {"const": 1, "type": "integer"},
        "source_ref": {"maxLength": 512, "pattern": "^reviewed_source:[0-9a-f]{24}$", "type": "string"},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "record_count": {"maximum": 4096, "minimum": 1, "type": "integer"},
        "review_refs": {"$ref": "#/$defs/reviewRefs"}
      },
      "required": ["abi_version", "source_ref", "path", "sha256", "record_count", "review_refs"],
      "type": "object"
    }
  }
}
