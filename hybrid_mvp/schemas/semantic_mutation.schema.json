{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cemm.invalid/schemas/semantic_mutation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abi_version",
    "mutation_ref",
    "parent_case_ref",
    "parent_contract_ref",
    "scope",
    "dimension",
    "changed_path",
    "before",
    "after",
    "mutated_case",
    "expected_earliest_owner",
    "expected_status",
    "expected_error_code",
    "lineage_refs",
    "review_refs"
  ],
  "properties": {
    "abi_version": {
      "const": 2
    },
    "mutation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "parent_case_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "parent_contract_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
    },
    "scope": {
      "enum": [
        "contract",
        "environment",
        "derivation",
        "persistence"
      ]
    },
    "dimension": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "changed_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "before": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array"
        },
        {
          "type": "object"
        }
      ]
    },
    "after": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array"
        },
        {
          "type": "object"
        }
      ]
    },
    "mutated_case": {
      "type": "object"
    },
    "expected_earliest_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "expected_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "expected_error_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "lineage_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    },
    "review_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z?][A-Za-z0-9_.:/?@+\\-]*$"
      }
    }
  }
}
