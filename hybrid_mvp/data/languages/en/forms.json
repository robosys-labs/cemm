{
  "language": "en",
  "abi_version": 7,
  "tokenization": {
    "lowercase": true,
    "split_whitespace": true,
    "split_punctuation": true,
    "split_contractions": true,
    "contractions": ["don't", "can't", "won't", "isn't", "aren't", "wasn't", "weren't", "hasn't", "haven't", "didn't", "doesn't", "wouldn't", "couldn't", "shouldn't"],
    "punctuation": [".", ",", "!", "?", ";", ":", "'", "\"", "(", ")", "“", "”", "‘", "’", "«", "»", "‹", "›"]
  },
  "orthography": {
    "'": {"kind": "quotation_boundary"},
    "\"": {"kind": "quotation_boundary"},
    "“": {"kind": "quotation_boundary"},
    "”": {"kind": "quotation_boundary"},
    "‘": {"kind": "quotation_boundary"},
    "’": {"kind": "quotation_boundary"},
    "«": {"kind": "quotation_boundary"},
    "»": {"kind": "quotation_boundary"},
    "‹": {"kind": "quotation_boundary"},
    "›": {"kind": "quotation_boundary"},
    ".": {"kind": "sentence_boundary"},
    "!": {"kind": "sentence_boundary"},
    "?": {"kind": "sentence_boundary"},
    ";": {"kind": "sentence_boundary"}
  },
  "morphology": {
    "plural_suffixes": ["s", "es", "ies"],
    "past_tense_suffixes": ["ed", "d"],
    "participle_suffixes": ["ing", "ed"],
    "comparative_suffixes": ["er", "est"]
  },
  "participant_deixis": {
    "i": {"kind": "reference_user"},
    "me": {"kind": "reference_user"},
    "my": {"kind": "possessive_user"},
    "mine": {"kind": "possessive_user"},
    "you": {"kind": "reference_system"},
    "your": {"kind": "possessive_system"},
    "yours": {"kind": "possessive_system"},
    "we": {"kind": "reference_group"},
    "us": {"kind": "reference_group"},
    "our": {"kind": "possessive_group"},
    "they": {"kind": "reference_other"},
    "them": {"kind": "reference_other"},
    "their": {"kind": "possessive_other"},
    "this": {"kind": "proximal"},
    "that": {"kind": "distal"},
    "these": {"kind": "proximal"},
    "those": {"kind": "distal"}
  },
  "binders": {
    "is": {"kind": "copula"},
    "are": {"kind": "copula"},
    "was": {"kind": "copula"},
    "were": {"kind": "copula"},
    "am": {"kind": "copula"},
    "be": {"kind": "copula"},
    "been": {"kind": "copula"},
    "being": {"kind": "copula"}
  },
  "query_projection": {
    "what": {"kind": "query", "interrogative": "content"},
    "who": {"kind": "query", "interrogative": "person"},
    "where": {"kind": "query", "interrogative": "location"},
    "when": {"kind": "query", "interrogative": "time"},
    "why": {"kind": "query", "interrogative": "reason"},
    "which": {"kind": "query", "interrogative": "selection"},
    "how": {"kind": "query", "interrogative": "manner"},
    "do": {"kind": "query_auxiliary"},
    "does": {"kind": "query_auxiliary", "construction_role": "lexical_query_auxiliary"},
    "did": {"kind": "query_auxiliary"},
    "has": {"kind": "query_auxiliary"},
    "have": {"kind": "query_auxiliary"},
    "list": {"kind": "query"},
    "tell": {"kind": "query"},
    "report": {"kind": "query"}
  },
  "polarity": {
    "not": {"kind": "negation"},
    "no": {"kind": "negation"},
    "never": {"kind": "negation"},
    "n't": {"kind": "negation"},
    "none": {"kind": "negation"},
    "nothing": {"kind": "negation"}
  },
  "modality": {
    "can": {"kind": "capability"},
    "could": {"kind": "capability"},
    "may": {"kind": "permission"},
    "might": {"kind": "possibility"},
    "must": {"kind": "obligation"},
    "should": {"kind": "obligation"},
    "would": {"kind": "conditional"},
    "shall": {"kind": "obligation"},
    "will": {"kind": "future"},
    "able": {"kind": "capability"},
    "possible": {"kind": "possibility"}
  },
  "tense_aspect": {
    "will": {"kind": "future"},
    "have": {"kind": "perfect"},
    "has": {"kind": "perfect"},
    "had": {"kind": "pluperfect"},
    "currently": {"kind": "temporal_qualifier"},
    "now": {"kind": "temporal_qualifier"},
    "then": {"kind": "temporal_qualifier"},
    "already": {"kind": "temporal_qualifier"},
    "still": {"kind": "temporal_qualifier"},
    "yet": {"kind": "temporal_qualifier"}
  },
  "connectors": {
    "because": {"kind": "causal"},
    "so": {"kind": "causal"},
    "therefore": {"kind": "causal"},
    "but": {"kind": "contrast"},
    "however": {"kind": "contrast"},
    "although": {"kind": "contrast"},
    "though": {"kind": "contrast"},
    "and": {"kind": "conjunction"},
    "or": {"kind": "disjunction"},
    "nor": {"kind": "disjunction"},
    "if": {"kind": "conditional"},
    "unless": {"kind": "conditional"},
    "suppose": {"kind": "hypothetical"},
    "imagine": {"kind": "hypothetical"},
    "in order to": {"kind": "purpose"},
    "so that": {"kind": "purpose"},
    "to": {"kind": "purpose"},
    "for": {"kind": "purpose"},
    "then": {"kind": "sequence"},
    "next": {"kind": "sequence"},
    "after that": {"kind": "sequence"},
    "subsequently": {"kind": "sequence"}
  },
  "correction": {
    "no": {"kind": "correction"},
    "actually": {"kind": "correction"},
    "rather": {"kind": "correction"},
    "instead": {"kind": "correction"},
    "sorry": {"kind": "correction"}
  },
  "discourse": {
    "?": {"kind": "question"},
    "said": {"kind": "report"},
    "told": {"kind": "report"},
    "asked": {"kind": "report"},
    "says": {"kind": "report"},
    "means": {"kind": "definition_marker"},
    "mean": {"kind": "definition_marker", "construction_role": "lexical_query_terminal"},
    "means that": {"kind": "definition_marker"},
    "it": {"kind": "discourse_particle"},
    "there": {"kind": "discourse_particle"}
  },
  "determiners": {
    "the": {"kind": "determiner", "construction_role": "query_target_article"},
    "a": {"kind": "determiner", "construction_role": "query_target_article"},
    "an": {"kind": "determiner", "construction_role": "query_target_article"},
    "some": {"kind": "determiner"},
    "any": {"kind": "determiner"},
    "all": {"kind": "determiner"},
    "every": {"kind": "determiner"}
  },
  "linkers": {
    "in": {"kind": "restriction_linker"},
    "to": {"kind": "linker"},
    "of": {"kind": "linker"},
    "as": {"kind": "linker"},
    "for": {"kind": "linker"},
    "that": {"kind": "content_linker"},
    "about": {"kind": "linker"}
  },
  "scope_values": {
    "polarity": {
      "negation": "scope_value:polarity:negative"
    },
    "modality": {
      "capability": "scope_value:modality:capability",
      "permission": "scope_value:modality:permission",
      "possibility": "scope_value:modality:possibility",
      "obligation": "scope_value:modality:obligation",
      "conditional": "scope_value:modality:conditional",
      "future": "scope_value:modality:future"
    },
    "tense": {
      "future": "scope_value:tense:future",
      "perfect": "scope_value:tense:perfect",
      "pluperfect": "scope_value:tense:pluperfect",
      "temporal_qualifier": "scope_value:tense:temporal_qualifier"
    },
    "aspect": {
      "future": "scope_value:aspect:future",
      "perfect": "scope_value:aspect:perfect",
      "pluperfect": "scope_value:aspect:pluperfect",
      "temporal_qualifier": "scope_value:aspect:temporal_qualifier"
    },
    "attribution": {
      "report": "scope_value:attribution:report",
      "definition_marker": "scope_value:attribution:definition"
    }
  },
  "link_schemas": {
    "coordination": {"link_type": "link:coordination", "commutative": true, "min_arity": 2, "max_arity": 4},
    "conjunction": {"link_type": "link:conjunction", "commutative": true, "min_arity": 2, "max_arity": 4},
    "disjunction": {"link_type": "link:disjunction", "commutative": true, "min_arity": 2, "max_arity": 4},
    "conditional": {"link_type": "link:condition", "commutative": false, "min_arity": 2, "max_arity": 2},
    "causal": {"link_type": "link:cause", "commutative": false, "min_arity": 2, "max_arity": 2},
    "contrast": {"link_type": "link:contrast", "commutative": false, "min_arity": 2, "max_arity": 2},
    "purpose": {"link_type": "link:purpose", "commutative": false, "min_arity": 2, "max_arity": 2},
    "sequence": {"link_type": "link:sequence", "commutative": false, "min_arity": 2, "max_arity": 4}
  },
  "application_role_orders": {
    "communicative_actor_event_addressee": {
      "construction": "communicative_event",
      "evidence_order": [
        {"kind": "referent", "role": "role:actor", "target_kinds": ["entity", "participant"], "cardinality": "optional"},
        {"kind": "designation", "role": "role:event", "target_kind": "event_type"},
        {"kind": "referent", "role": "role:addressee", "target_kinds": ["entity", "participant"], "cardinality": "optional"}
      ]
    },
    "content_target_projection": {
      "evidence_order": [
        {"kind": "feature", "port": "request", "features": [["query", "query"], ["interrogative", "content"]]},
        {"kind": "feature", "port": "binder", "features": [["binder", "copula"]]},
        {"kind": "feature", "port": "determiner", "features": [["determiner", "determiner"], ["construction_role", "query_target_article"]], "cardinality": "optional"},
        {"kind": "designation", "port": "target", "target_kinds": ["concept", "entity", "participant"]}
      ],
      "result": {"kind": "query_projection", "target_port": "target", "requested_contents": ["description", "definition"]}
    },
    "effect_event_target_value": {
      "target_kinds": ["event_type", "entity", "state_value"],
      "roles": ["role:event", "role:target", "role:value"]
    },
    "modal_event_actor_target": {
      "target_kinds": ["participant", "event_type", "participant"],
      "roles": ["role:actor", "role:event", "role:target"],
      "required_features": ["modality"]
    },
    "relation_subject_predicate_object": {
      "target_kinds": ["entity", "relation_type", "entity"],
      "roles": ["role:subject", "role:relation", "role:object"],
      "evidence_order": [
        {"kind": "referent", "target_kinds": ["entity", "participant"], "role": "role:subject"},
        {"kind": "designation", "target_kind": "relation_type", "role": "role:relation"},
        {"kind": "referent", "target_kinds": ["entity", "participant"], "role": "role:object"}
      ]
    },
    "relation_subject_predicate_query_object": {
      "target_kinds": ["entity", "relation_type"],
      "roles": ["role:subject", "role:relation"],
      "required_features": ["query"],
      "evidence_order": [
        {"kind": "designation", "target_kind": "entity", "role": "role:subject"},
        {"kind": "designation", "target_kind": "relation_type", "role": "role:relation"},
        {"kind": "feature", "features": [["query", "query"], ["interrogative", "person"]], "role": "role:object"}
      ]
    },
    "relation_predicate_subject_query_object": {
      "target_kinds": ["relation_type", "entity"],
      "roles": ["role:relation", "role:object"],
      "required_features": ["query"],
      "evidence_order": [
        {"kind": "feature", "features": [["query", "query"], ["interrogative", "person"]], "role": "role:subject"},
        {"kind": "designation", "target_kind": "relation_type", "role": "role:relation"},
        {"kind": "designation", "target_kind": "entity", "role": "role:object"}
      ]
    },
    "relation_object_subject_predicate": {
      "target_kinds": ["entity", "entity", "relation_type"],
      "roles": ["role:object", "role:subject", "role:relation"]
    },
    "state_subject_value": {
      "target_kinds": ["entity", "state_value"],
      "roles": ["role:subject", "role:value"],
      "required_features": ["binder"]
    },
    "state_value_subject": {
      "target_kinds": ["state_value", "entity"],
      "roles": ["role:value", "role:subject"],
      "required_features": ["binder"]
    },
    "reported_state_content": {
      "target_kinds": ["entity", "event_type", "entity", "state_value"],
      "roles": ["role:actor", "role:event", "role:subject", "role:value"],
      "required_features": ["binder"]
    },
    "reported_relation_content": {
      "target_kinds": ["entity", "event_type", "entity", "relation_type", "entity"],
      "roles": ["role:actor", "role:event", "role:subject", "role:relation", "role:object"],
      "required_features": ["discourse"]
    },
    "reported_event_content": {
      "target_kinds": ["entity", "event_type", "event_type"],
      "roles": ["role:actor", "role:event", "role:event"],
      "required_features": ["discourse"]
    },
    "definition_nominal_query": {
      "target_kinds": ["concept"],
      "roles": ["role:subject"],
      "required_features": ["query"]
    },
    "definition_participant_query": {
      "target_kinds": ["participant"],
      "roles": ["role:subject"],
      "required_features": ["query"]
    },
    "label_designation_query": {
      "target_kinds": ["participant", "label_type"],
      "roles": ["role:target", "role:label_type"],
      "required_features": ["query"]
    }
  }
}
